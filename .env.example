# ─── REQUIRED ────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=21866171
API_HASH=5788dba8f23fade5edda55948e985f06

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=

# Your Telegram numeric user ID (get it by sending /id to the bot)
OWNER=1289248746

# ─── OPTIONAL ─────────────────────────────────────────
# Display name shown in captions
CREDIT=MRBERLIN

# MongoDB connection string (for user auth persistence)
# Get free cluster at https://cloud.mongodb.com
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Vimeo Worker URL (optional — only needed for Vimeo links)
# Deploy worker.js to Cloudflare Workers and paste the URL here
VIMEO_WORKER_URL=

# Path to YouTube cookies file (default: youtube_cookies.txt)
cookies_file_path=youtube_cookies.txt

# Max parallel watermark encodes (default: 2)
WM_MAX_PARALLEL=2
